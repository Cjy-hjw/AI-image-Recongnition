# Ignore dataset and weights
# 注:必须用前导 / 锚定到仓库根,否则无锚定的 data/ 会匹配任意层级的 data 目录,
#     误伤 scripts/data/ 源码包(曾导致 CI 因缺 pseudo_labels.py 等文件而 collect 失败)。
/data/
/checkpoints/
# 预训练权重本地缓存(546MB),禁止入库——过大导致 push 经代理超时;
# 权重由 scripts/download_pretrain_weights.py 按需重新下载。
/.cache_weights/
*.pth
*.pt

# Claude 本地会话/计划文件
/.claude/plan.md

# 账号密码(含 HF token 等敏感凭据),严禁入库
/账号密码/

# Python cache and temporary files
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.cache/
.ipynb_checkpoints/

# System files
desktop.ini
.DS_Store

# Gate2 审查标记(运行时状态,不入库)
/.claude/.gate2_pass.json
/.claude/.gate2_pending.json

# JSONL 训练日志(V2.1 硬约束产物)。云端正式训练落
# `/2026aicompetition/workspace/logs`(容器内绝对路径,不在仓库);本地冒烟用
# `--log-dir logs` 落这里,是一次性运行产物、不入库。
/logs/

# Gate2 验证产物(主会话 tmp_main_* / 各路审查子agent tmp_review_<lane>_*)。
# 这些是「交产物不交自述」要求下的可重跑证据脚本(rules.md §2/§8),跑完留在工作区
# 供主会话复核,但**不入库**——它们是一次性证据、不是项目代码。
# 命名空间隔离的由来:2026-08-12 一路审查 agent 清理临时文件时,把主会话的
# `tmp_verify_walk_order.py` 当自己的垃圾一并删了,导致其结论失去可核验证据。
# 现规定每路 agent 只能删自己前缀的文件,详见 rules.md §8。
/tmp_main_*.py
/tmp_review_*.py
/tmp_review_*.txt
/tmp_verify_*.py
# 兜底:上面按扩展名逐条列会漏(2026-08-12 实证 —— pytest 输出的 `tmp_main_*.log`
# 就没被上面任何一条盖住,以 untracked 身份出现在 git status 里);按前缀逐条列同样会漏
# (新起一个 `tmp_qavp_*` 前缀就又漏了)。改用单条通配收口:凡 `tmp_` 开头一律不入库。
/tmp_*

# 2026-10-18 开源清理:内部工作文档与官方材料不入公开仓
/docs/历史存档/
/docs/官方原文/
/docs/8.1赛事公开资料/
/docs/项目现状总纲.md
/docs/会话状态*.md
/docs/待官方答复清单.md
/docs/提示词_*.md
/docs/新架构*.md
/docs/Opus战略咨询*.md
/技术方案模板及撰写要求.wps
/cloud_train_*.zip
